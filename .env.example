# ==============================================================================
# ExamAI Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual config.
# ==============================================================================

# Security
# Generate a secret key in python: secrets.token_urlsafe(50)
SECRET_KEY=replace_with_a_secure_random_50_character_secret_key_for_production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ==============================================================================
# Database Configuration
# Supported DB_ENGINE options: 'mysql' (Recommended) or 'sqlite' (Development/Fallback)
# ==============================================================================
DB_ENGINE=mysql
DB_NAME=examai
DB_USER=examai_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ==============================================================================
# AI Provider Configurations (Optional - for syllabus parsing & paper generation)
# ==============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_FALLBACK_MODEL=claude-3-sonnet-20240229

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-latest

# ==============================================================================
# Email Configuration (Campaigns, Security Alerts, Password Reset OTPs)
# If EMAIL_HOST / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD are left empty,
# Django automatically falls back to console backend (emails printed to terminal).
#
# Free Provider Options:
# 1. Brevo (formerly Sendinblue) - 300 emails/day free forever (RECOMMENDED):
#    EMAIL_HOST=smtp-relay.brevo.com
#    EMAIL_PORT=587
#    EMAIL_HOST_USER=your_brevo_account_login_email
#    EMAIL_HOST_PASSWORD=your_brevo_smtp_master_key
#    EMAIL_USE_TLS=true
#    DEFAULT_FROM_EMAIL=verified_sender@yourdomain.com
#
# 2. Gmail App Password - 500 emails/day free:
#    Enable 2-Step Verification in Google Account -> Create an "App Password"
#    EMAIL_HOST=smtp.gmail.com
#    EMAIL_PORT=587
#    EMAIL_HOST_USER=your_gmail_address@gmail.com
#    EMAIL_HOST_PASSWORD=your_16_character_app_password
#    EMAIL_USE_TLS=true
#    DEFAULT_FROM_EMAIL=your_gmail_address@gmail.com
#
# 3. Mailjet - 200 emails/day (6,000/mo) free forever:
#    EMAIL_HOST=in-v3.mailjet.com
#    EMAIL_PORT=587
#    EMAIL_HOST_USER=your_mailjet_api_key
#    EMAIL_HOST_PASSWORD=your_mailjet_secret_key
#    EMAIL_USE_TLS=true
# ==============================================================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=noreply@examai.local

# Quota & Rate Limits (safety safeguards against provider throttling/suspension)
EMAIL_MAX_PER_MINUTE=30
EMAIL_MAX_PER_DAY=300
EMAIL_BATCH_SIZE=20
EMAIL_BATCH_DELAY_SECONDS=1.0


# ==============================================================================
# Local Ollama AI Subjective Evaluation & Generation Configuration
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_FALLBACK_MODELS=llama3.2:3b,phi3:mini
OLLAMA_TIMEOUT=120
OLLAMA_CALL_TIMEOUT=90
OLLAMA_JOB_TIMEOUT=360
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_PARALLEL=1
OLLAMA_MAX_BATCH_SIZE=6
OLLAMA_LONG_ANSWER_BATCH_SIZE=1
OLLAMA_LONG_ANSWER_SINGLE_PASS=true
OLLAMA_MAX_RETRIES=2
OLLAMA_WARMUP_ON_INIT=true
FACULTY_DEBUG_MODE=false
SYLLABUS_CACHE_TTL=3600

# Optional Model Routing (use smaller/faster installed model for objective questions)
ENABLE_MODEL_ROUTING=false
OLLAMA_OBJECTIVE_MODEL=qwen2.5:3b-instruct
OLLAMA_SUBJECTIVE_MODEL=qwen2.5:3b-instruct

EVAL_PROVIDER_ORDER=ollama,rules
CLOUD_PROVIDER=none
CLOUD_API_KEY=
CLOUD_MODEL=

# ==============================================================================
# Centralized Super Admin Configuration
# ==============================================================================
# Secret URL slug prefix for cloaked Super Admin endpoints (generate via: python manage.py generate_super_admin_path)
SUPER_ADMIN_PATH=replace_with_random_32_plus_character_slug_generated_by_command
# Optional comma-separated IP allowlist for super admin portal (leave blank to allow all IPs)
SUPER_ADMIN_ALLOWED_IPS=
# Hard limit on number of Super Admin accounts permitted (default: 1)
MAX_SUPER_ADMIN_COUNT=1
# Security notification email recipient for super admin alerts
SUPER_ADMIN_ALERT_EMAIL=harshposhiya92@gmail.com


