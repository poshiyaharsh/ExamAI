# ==============================================================================
# ExamAI Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual config.
# ==============================================================================

# Security
# Generate a secret key in python: secrets.token_urlsafe(50)
SECRET_KEY=replace_with_a_secure_random_50_character_secret_key_for_production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ==============================================================================
# Database Configuration
# Supported DB_ENGINE options: 'mysql' (Recommended) or 'sqlite' (Development/Fallback)
# ==============================================================================
DB_ENGINE=mysql
DB_NAME=examai
DB_USER=examai_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# ==============================================================================
# AI Provider Configurations (Optional - for syllabus parsing & paper generation)
# ==============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_FALLBACK_MODEL=claude-3-sonnet-20240229

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-latest

# ==============================================================================
# Email Configuration (Password reset OTP notifications)
# If left blank, console backend is used (emails printed to terminal)
# ==============================================================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=noreply@examai.local

# ==============================================================================
# Local Ollama AI Subjective Evaluation & Generation Configuration
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_FALLBACK_MODELS=llama3.2:3b,phi3:mini
OLLAMA_TIMEOUT=120
OLLAMA_CALL_TIMEOUT=90
OLLAMA_JOB_TIMEOUT=360
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_PARALLEL=1
OLLAMA_MAX_BATCH_SIZE=6
OLLAMA_LONG_ANSWER_BATCH_SIZE=1
OLLAMA_LONG_ANSWER_SINGLE_PASS=true
OLLAMA_MAX_RETRIES=2
OLLAMA_WARMUP_ON_INIT=true
FACULTY_DEBUG_MODE=false
SYLLABUS_CACHE_TTL=3600

# Optional Model Routing (use smaller/faster installed model for objective questions)
ENABLE_MODEL_ROUTING=false
OLLAMA_OBJECTIVE_MODEL=qwen2.5:3b-instruct
OLLAMA_SUBJECTIVE_MODEL=qwen2.5:3b-instruct

EVAL_PROVIDER_ORDER=ollama,rules
CLOUD_PROVIDER=none
CLOUD_API_KEY=
CLOUD_MODEL=


